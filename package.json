{
  "name": "exceljs",
  "version": "4.4.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=12.0.0"
  },
  "main": "./index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./lib/exceljs.browser.js",
      "node": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "index.js",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "test": "npm run test:vitest",
    "test:full": "npm run test:vitest",
    "test:version": "npm run build && npm run test:vitest",
    "test:all": "npm run test:vitest",
    "test:native": "npm run test:vitest",
    "test:vitest": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:vitest:watch": "vitest",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:browser": "vitest run --config vitest.browser.config.ts",
    "test:vitest:browser:ui": "vitest --config vitest.browser.config.ts --ui",
    "test:manual": "node spec/manual/app.js",
    "clean-build": "npm run clean && npm run build",
    "lint": "oxlint .",
    "type": "tsgo --noEmit",
    "lint:fix": "oxlint --fix .",
    "lint:staged": "lint-staged",
    "clean": "rm -rf build/ && rm -rf dist",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark",
    "build:types": "tsgo",
    "build:entries": "tsgo -p tsconfig.build.json",
    "build:bundle": "rolldown -c rolldown.config.js",
    "build": "npm run build:types && npm run build:entries && npm run build:bundle",
    "install-build": "npm install && npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "preversion": "npm run clean && npm run build && npm run test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^7.0.1",
    "dayjs": "^1.11.18",
    "fast-csv": "^5.0.5",
    "jszip": "^3.10.1",
    "readable-stream": "^4.7.0",
    "saxes": "^6.0.0",
    "tmp": "^0.2.5",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.8.1",
    "@types/tmp": "^0.2.6",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^11.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20251021.1",
    "@vitest/browser": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "buffer": "^6.0.3",
    "core-js": "^3.6.5",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "express": "^4.16.4",
    "fast-xml-parser": "^5.3.0",
    "husky": "^4.3.0",
    "lint-staged": "^10.2.13",
    "oxlint": "^1.23.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "process": "^0.11.10",
    "regenerator-runtime": "^0.13.7",
    "rolldown": "^1.0.0-beta.44",
    "sax": "^1.2.4",
    "stream-browserify": "^3.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "util": "^0.12.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
