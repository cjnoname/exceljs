{
  "name": "exceljs",
  "version": "4.4.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=12.0.0"
  },
  "main": "./excel.js",
  "browser": "./dist/exceljs.min.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./excel.js",
      "default": "./excel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "excel.js",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.ts",
    "index.d.ts"
  ],
  "scripts": {
    "test": "npm run test:vitest",
    "test:full": "npm run test:vitest",
    "test:version": "npm run build && npm run test:vitest",
    "test:all": "npm run test:vitest",
    "test:native": "npm run test:vitest",
    "test:vitest": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:vitest:watch": "vitest",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:browser": "vitest run --config vitest.browser.config.ts",
    "test:vitest:browser:ui": "vitest --config vitest.browser.config.ts --ui",
    "test:manual": "node spec/manual/app.js",
    "clean-build": "npm run clean && npm run build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:staged": "lint-staged",
    "clean": "rm -rf build/ && rm -rf dist",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark",
    "build": "rollup -c rollup.config.js",
    "install-build": "npm install && npm run build",
    "preversion": "npm run clean && npm run build && npm run test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^7.0.1",
    "dayjs": "^1.11.18",
    "fast-csv": "^5.0.5",
    "jszip": "^3.10.1",
    "readable-stream": "^4.7.0",
    "saxes": "^6.0.0",
    "tmp": "^0.2.5",
    "unzipper": "^0.12.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.10.5",
    "@babel/core": "^7.11.4",
    "@babel/preset-env": "^7.11.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.8.1",
    "@types/tmp": "^0.2.6",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^11.0.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "buffer": "^6.0.3",
    "core-js": "^3.6.5",
    "express": "^4.16.4",
    "fast-xml-parser": "^5.3.0",
    "husky": "^4.3.0",
    "lint-staged": "^10.2.13",
    "node-stdlib-browser": "^1.3.1",
    "oxlint": "^1.23.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "regenerator-runtime": "^0.13.7",
    "rollup": "^4.52.5",
    "rollup-plugin-copy": "^3.5.0",
    "sax": "^1.2.4",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
