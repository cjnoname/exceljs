{
  "name": "excelts",
  "version": "0.1.0",
  "description": "TypeScript Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "cjnoname",
    "email": "powerfulj87@gmail.com"
  },
  "contributors": [
    {
      "name": "Guyon Roche",
      "email": "guyon@live.com",
      "url": "https://github.com/guyonroche"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cjnoname/exceljs.git"
  },
  "homepage": "https://github.com/cjnoname/exceljs#readme",
  "bugs": {
    "url": "https://github.com/cjnoname/exceljs/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": {
        "import": "./dist/exceljs.browser.mjs",
        "default": "./dist/exceljs.browser.mjs"
      },
      "import": "./dist/exceljs.node.mjs",
      "require": "./dist/exceljs.node.cjs",
      "default": "./dist/exceljs.node.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "test": "npm run test:vitest",
    "test:full": "npm run test:vitest",
    "test:version": "npm run build && npm run test:vitest",
    "test:all": "npm run test:vitest",
    "test:native": "npm run test:vitest",
    "test:vitest": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:vitest:watch": "vitest",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:browser": "vitest run --config vitest.browser.config.ts",
    "test:vitest:browser:ui": "vitest --config vitest.browser.config.ts --ui",
    "build": "rimraf dist && npm run build:types && npm run build:bundle",
    "clean": "pnpm dlx --reporter=silent rimraf \"**/node_modules\" pnpm-lock.yaml \"**/dist\" -g && pnpm i",
    "lint": "oxlint",
    "type": "tsgo --noEmit",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "lint:staged": "lint-staged",
    "benchmark": "npm run build && node --expose-gc benchmark.js",
    "build:types": "tsgo --project tsconfig.build.json",
    "build:bundle": "rolldown -c rolldown.config.js",
    "analyze": "ANALYZE=1 rolldown -c rolldown.config.js",
    "install-build": "npm install && npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "preversion": "npm run clean && npm run build && npm run test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "keywords": [
    "excelts",
    "typescript",
    "excel",
    "xlsx",
    "json",
    "csv",
    "spreadsheet",
    "workbook",
    "exceljs",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup",
    "modern",
    "esm",
    "xlsx"
  ],
  "dependencies": {
    "dayjs": "^1.11.18",
    "fast-csv": "^5.0.5",
    "fflate": "^0.8.2",
    "node-stdlib-browser": "^1.3.1",
    "saxes": "^6.0.0",
    "typescript-eslint": "^8.46.2",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@oxc-node/core": "^0.0.32",
    "@types/node": "^24.9.1",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@typescript/native-preview": "^7.0.0-dev.20251023.1",
    "@vitest/browser": "^4.0.2",
    "@vitest/browser-playwright": "^4.0.2",
    "@vitest/ui": "^4.0.2",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-oxlint": "1.24.0",
    "eslint-plugin-unused-imports": "4.3.0",
    "eslint-rspack-plugin": "4.2.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "husky": "^9.1.7",
    "oxlint": "^1.24.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rolldown": "^1.0.0-beta.44",
    "rollup-plugin-visualizer": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.2"
  }
}
