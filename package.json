{
  "name": "exceljs",
  "version": "4.4.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": {
        "import": "./dist/exceljs.browser.mjs",
        "default": "./dist/exceljs.browser.mjs"
      },
      "import": "./dist/exceljs.node.mjs",
      "require": "./dist/exceljs.node.cjs",
      "default": "./dist/exceljs.node.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "test": "npm run test:vitest",
    "test:full": "npm run test:vitest",
    "test:version": "npm run build && npm run test:vitest",
    "test:all": "npm run test:vitest",
    "test:native": "npm run test:vitest",
    "test:vitest": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:vitest:watch": "vitest",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:browser": "vitest run --config vitest.browser.config.ts",
    "test:vitest:browser:ui": "vitest --config vitest.browser.config.ts --ui",
    "build": "rimraf dist && npm run build:types && npm run build:bundle",
    "clean": "pnpm dlx --reporter=silent rimraf \"**/node_modules\" pnpm-lock.yaml \"**/dist\" -g && pnpm i",
    "lint": "oxlint",
    "type": "tsgo --noEmit",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "lint:staged": "lint-staged",
    "benchmark": "node --expose-gc benchmark.js",
    "build:types": "tsgo --project tsconfig.build.json",
    "build:bundle": "rolldown -c rolldown.config.js",
    "analyze": "ANALYZE=1 rolldown -c rolldown.config.js",
    "install-build": "npm install && npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "preversion": "npm run clean && npm run build && npm run test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "dayjs": "^1.11.18",
    "fast-csv": "^5.0.5",
    "fflate": "^0.8.2",
    "node-stdlib-browser": "^1.3.1",
    "saxes": "^5.0.1",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@oxc-node/core": "^0.0.32",
    "@types/node": "^24.9.1",
    "@types/unzipper": "^0.10.11",
    "@typescript/native-preview": "^7.0.0-dev.20251022.1",
    "@vitest/browser": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "express": "^4.16.4",
    "fast-xml-parser": "^5.3.0",
    "husky": "^9.1.7",
    "oxlint": "^1.23.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rolldown": "^1.0.0-beta.44",
    "rollup-plugin-visualizer": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
