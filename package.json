{
  "name": "exceljs",
  "version": "4.4.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=12.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": {
        "import": "./dist/exceljs.esm.js",
        "default": "./dist/exceljs.esm.js"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "test": "npm run test:vitest",
    "test:full": "npm run test:vitest",
    "test:version": "npm run build && npm run test:vitest",
    "test:all": "npm run test:vitest",
    "test:native": "npm run test:vitest",
    "test:vitest": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:vitest:watch": "vitest",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:browser": "vitest run --config vitest.browser.config.ts",
    "test:vitest:browser:ui": "vitest --config vitest.browser.config.ts --ui",
    "clean-build": "npm run clean && npm run build",
    "lint": "oxlint",
    "type": "tsgo --noEmit",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "lint:staged": "lint-staged",
    "clean": "rm -rf build/ && rm -rf dist",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark",
    "build:types": "tsgo",
    "build:bundle": "rolldown -c rolldown.config.js",
    "build": "npm run build:types && npm run build:bundle",
    "install-build": "npm install && npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "preversion": "npm run clean && npm run build && npm run test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "dayjs": "^1.11.18",
    "fast-csv": "^5.0.5",
    "fflate": "^0.8.2",
    "htmlparser2": "^10.0.0",
    "node-stdlib-browser": "^1.3.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@typescript/native-preview": "^7.0.0-dev.20251021.1",
    "@vitest/browser": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "express": "^4.16.4",
    "fast-xml-parser": "^5.3.0",
    "husky": "^9.1.7",
    "oxlint": "^1.23.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rolldown": "^1.0.0-beta.44",
    "rollup-plugin-visualizer": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
