{
  "rules": {
    "typescript/no-namespace": "off",
    "typescript/no-explicit-any": "off",
    "unicorn/filename-case": "off",
    "no-console": "warn",
    "no-continue": "off",
    "no-plusplus": "off",
    "no-prototype-builtins": "off",
    "no-underscore-dangle": "off",
    "no-unused-vars": "warn",
    "max-len": "off",
    "prefer-destructuring": "warn"
  },
  "env": {
    "node": true,
    "es2021": true
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "nursery": "off"
  }
}
