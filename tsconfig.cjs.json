{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "./dist/cjs",
    "rootDir": ".",
    "moduleResolution": "node"
  },
  "include": [
    "index.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.d.ts",
    "lib/**/*"
  ]
}
