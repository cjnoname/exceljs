{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2019",
    "lib": ["ESNext"],
    "sourceMap": true,
    "types": [
      "vitest/globals"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node"
  },
  "exclude": [
    "node_modules"
  ]
}
