{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2019",
    "lib": ["ESNext"],
    "sourceMap": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "spec",
    "vitest.config.ts",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
